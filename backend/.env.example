# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Free models, tried in order (comma-separated). Free tier: about 20 requests/minute, 50/day without credits.
LLM_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Seconds before giving up on the AI and using the rule-based fallback.
LLM_TIMEOUT_S=20

# Set to 1 to force the offline rule-based fallback (rehearse the backup demo).
LIGHTCONE_OFFLINE=0
